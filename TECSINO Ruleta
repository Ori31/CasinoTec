import java.util.*;

public class ruleta {
    // datos extra
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        Double bud=1500.00;
        Double ganancia=  0.00 ;
        char juego ;
        System.out.println("presupuesto: " + bud);
        System.out.println("Deseas jugar (S/N)");
        juego= sc.next().charAt(0);

            do { 
                System.out.println("Pon tu apuesta ");
                double apuesta=sc.nextDouble();
                if (apuesta<=bud){
                    System.out.println("Elije tu numero (1-36), o un color: ");
                    String select=sc.next();
                    int rulet= (int)(Math.random()*36);
                    int ruletColor= (int)(Math.random()*1);
                    String colorR= (ruletColor==1)? "negro": "rojo";
                    switch (select) {
                        case "negro":
                            if (colorR=="negro") {
                                ganancia= (apuesta*2);
                                System.out.println("¡¡¡¡GANASTE!!!!");
                                System.out.println("El numero es: " + rulet +  " y su color es: " + colorR );
                                System.out.println("Presupuesto: "+ (bud+ganancia));
                            } else{
                                ganancia= (bud-apuesta);
                                System.out.println("Perdiste");
                                System.out.println("El numero es: " + rulet +  " y su color es: " + colorR );
                                System.out.println("Presupuesto: "+ ganancia);

                            }
                            break;
                            case "rojo":
                                if (colorR=="rojo") {
                                ganancia= (apuesta*2);
                                System.out.println("¡¡¡¡GANASTE!!!!");
                                System.out.println("El numero es: " + rulet +  " y su color es: " + colorR );
                                System.out.println("Presupuesto: "+ (bud+ganancia));
                            } else{
                                ganancia= (bud-apuesta);
                                System.out.println("Perdiste");
                                System.out.println("El numero es: " + rulet +  " y su color es: " + colorR );
                                System.out.println("Presupuesto: "+ ganancia);

                            }
                            break;

                        default:
                            int numero= Integer.parseInt(select);
                            if (numero==rulet){
                                ganancia= (apuesta*4);
                                System.out.println("¡¡¡¡GANASTE!!!!");
                                System.out.println("El numero es: "+ rulet);
                                System.out.println("Presupuesto: "+ (bud+ganancia));
                            } else {
                                ganancia= (bud-apuesta);
                                System.out.println("Perdiste");
                                System.out.println("El numero es: "+ rulet);
                                System.out.println("Presupuesto: "+ ganancia);
                            }

                    }
                    bud = ganancia; 
                    
                } else {
                    System.out.println("ERROR");
                }
                System.out.println("Deseas jugar (S/N)");
                juego= sc.next().charAt(0);

            } while (((juego == 'S') || (juego == 's') && (bud>0)));

                
    }
}
